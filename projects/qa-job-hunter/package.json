{
  "name": "qa-job-hunter",
  "version": "1.0.0",
  "type": "module",
  "description": "Agentic job hunter for QA roles - LinkedIn scraper + Claude match analysis",
  "scripts": {
    "login": "npx tsx src/1-login.ts",
    "scrape": "npx tsx src/2-scrape-jobs.ts",
    "analyze": "npx tsx src/3-analyze-match.ts",
    "full-run": "npx tsx src/run-all.ts",
    "dashboard": "npx tsx src/serve-dashboard.ts",
    "db:seed": "npx tsx src/db/seed.ts",
    "tracker:seed": "npx tsx src/db/seed-applications.ts",
    "tracker:sync-pipeline": "npx tsx src/tracker/pipeline-sync.ts",
    "test:tracker": "npx tsx --test tests/tracker/estado-policy.test.ts tests/tracker/pipeline-sync.test.ts tests/tracker/automation-merge.test.ts tests/tracker/apply-queue-map.test.ts tests/tracker/apply-sync.test.ts tests/tracker/schema-b38-13.test.ts tests/tracker/applications-b38-13.test.ts",
    "test:api": "npx tsx --test tests/api/jobs.test.ts",    "playwright:ide": "npx tsx src/open-playwright-ide.ts",
    "easy-apply": "npx tsx src/easy-apply.ts",
    "easy-apply:dry-run": "npx tsx src/easy-apply-dry-run.ts",
    "apply:sync": "npx tsx agents/excel-bridge/sync-only.ts",
    "tracker:sync": "npx tsx agents/excel-bridge/sync-only.ts",
    "campaign": "npx tsx src/campaign/run-campaign.ts",
    "campaign:dry-run": "npx tsx src/campaign/run-campaign.ts --dry-run",
    "agent:gmail-fetch": "npx tsx agents/gmail-fetch/run.ts",
    "agent:pipeline": "npx tsx agents/pipeline-match/run.ts",
    "agent:excel": "npx tsx agents/excel-bridge/run.ts",
    "agent:gmail-reconcile": "npx tsx agents/gmail-reconcile/run.ts",
    "test:apply-notes": "npx tsx --test tests/apply/failed-fields-notes.test.ts",
    "test:unknown-strategy": "npx tsx --test tests/apply/unknown-field-strategy.test.ts",
    "test:config-bank": "npx tsx --test tests/apply/fill-config-bank.test.ts tests/config/questions-store.test.ts",
    "test:run-apply": "npx tsx --test tests/run/apply-runner.test.ts tests/run/apply-cancel.test.ts",
    "qa:process-audit": "npx tsx scripts/qa/process-audit.ts",
    "test:timing": "npx tsx --test tests/apply/timing.test.ts",
    "test:prefill-fast": "npx tsx --test tests/apply/prefill-fast-path.test.ts",
    "test:config-answer-ui": "npx tsx --test tests/dashboard/config-answer-strategies.test.ts",
    "test:field-options": "npx tsx --test tests/apply/field-options.test.ts",
    "test:config-field-sync": "npx tsx --test tests/apply/config-field-sync.test.ts",
    "test:resume-contract": "npx tsx --test tests/apply/resume-contract.test.ts",
    "smoke:resume": "npx tsx --test tests/apply/resume-contract.test.ts && npx tsx scripts/smoke-resume.ts",
    "test:indeed": "npx tsx --test tests/adapters/indeed-adapter.test.ts",
    "smoke:indeed": "npx tsx scripts/smoke-indeed.ts",
    "discover:indeed": "npx tsx scripts/discover-indeed.ts",
    "discover:notifications": "npx tsx scripts/discover-notifications.ts",
    "test:notifications-merge": "npx tsx --test tests/discovery/notifications-applied-list.test.ts",
    "qa:smoke-b38-13": "npx tsx scripts/qa/smoke-b38-13.ts",
    "qa:dry-run-campaign": "npx tsx scripts/qa/dry-run-campaign-gate.ts",
    "qa:dry-run-campaign:full": "npx tsx scripts/qa/dry-run-campaign-gate.ts",
    "qa:dry-run-campaign:pipeline": "npx tsx scripts/qa/dry-run-campaign-gate.ts --pipeline-only",
    "qa:regression-b38-13": "npx tsx scripts/qa/regression-b38-13.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "exceljs": "^4.4.0",
    "mongodb": "^6.16.0",
    "playwright": "^1.44.0"
  },
  "devDependencies": {
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "@types/node": "^20.12.0"
  }
}
