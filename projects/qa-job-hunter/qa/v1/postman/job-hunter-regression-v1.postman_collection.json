                  "pm.test('REG-V1-16 status 200 or 404', () => pm.expect([200,404,503]).to.include(pm.response.code));",
                  "if (pm.response.code === 200) pm.test('Enviada', () => pm.expect(pm.response.json().application.estado).to.eql('Enviada'));"
