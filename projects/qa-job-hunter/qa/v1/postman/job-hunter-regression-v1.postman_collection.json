  "item": [
    {
      "name": "00 Setup",
      "item": [
        {
          "name": "SETUP GET match-jobs (set sampleJobId)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/dashboard/match-jobs"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.jobs?.length > 0 && json.jobs[0].id) {",
                  "    const jobId = String(json.jobs[0].id);",
                  "    pm.collectionVariables.set('sampleJobId', jobId);",
                  "    pm.environment.set('sampleJobId', jobId);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Match Jobs",
      "item": [
        {
          "name": "REG-V1-04 GET match-jobs filter applied",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/dashboard/match-jobs?filter=applied"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('filter applied 200 or 503', () => {",
                  "  pm.expect([200, 503]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
